<?xml version="1.0"?>
<ruleset name="WooCommerce Crowdfunding">
	<description>WordPress Coding Standards for WooCommerce Crowdfunding.</description>

	<file>.</file>
	<exclude-pattern>/devdiggers-framework/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>
	<exclude-pattern>/i18n/*</exclude-pattern>
	<exclude-pattern>/bin/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="5.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- The autoloader maps DDWCCF_Foo_Bar to foo-bar.php, the DevDiggers file convention. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<!-- index.php "silence is golden" guards. -->
		<exclude name="Internal.NoCodeFound"/>
		<!-- DevDiggers code uses short array syntax. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="devdiggers-crowdfunding-for-woocommerce"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ddwccf"/>
				<element value="DDWCCrowdFunding"/>
			</property>
		</properties>
	</rule>
</ruleset>
